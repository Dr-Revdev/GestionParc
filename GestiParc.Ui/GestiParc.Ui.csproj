<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Informations de l'application -->
    <AssemblyName>GestiParc</AssemblyName>
    <Product>GestiParc - Gestion de Parc Informatique</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Dr-Revdev</Company>
    <Copyright>Copyright © 2025</Copyright>
    <Description>Application de gestion de parc informatique et d'équipements</Description>
    
    <!-- Configuration de publication -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    
    <!-- Icône de l'application -->
    <ApplicationIcon>..\GestionParc.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestiParc.Core\GestiParc.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\DTOs\" />
    <Folder Include="Data\Models\" />
    <Folder Include="Data\Repositories\Contracts\" />
    <Folder Include="Data\Repositories\MySQL\" />
    <Folder Include="Services\Api\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\GestionParc.ico" Link="GestionParc.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>